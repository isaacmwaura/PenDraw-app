{
  "name": "pendraw",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n APP,SYNC -c blue,green \"vite --host\" \"node server/sync-server.mjs\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server/sync-server.mjs",
    "serve": "node server/sync-server.mjs",
    "test": "vitest run",
    "lint": "oxlint src server tools vite.config.ts vitest.config.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sirv": "^3.0.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
