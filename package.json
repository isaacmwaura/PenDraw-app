{
  "name": "pendraw-monorepo",
  "private": true,
  "version": "0.2.4",
  "description": "PenDraw - pen-first whiteboard on Excalidraw with live LAN mirror",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@excalidraw/excalidraw": { "nanoid": "3.3.20" },
    "@excalidraw/mermaid-to-excalidraw": { "nanoid": "5.1.16" },
    "lodash-es": "4.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/pendraw",
    "build": "npm run build --workspace apps/pendraw",
    "start": "npm run start --workspace apps/pendraw",
    "test": "npm run test --workspace apps/pendraw",
    "lint": "npm run lint --workspace apps/pendraw",
    "typecheck": "npm run typecheck --workspace apps/pendraw",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:browser": "npm run build && node apps/pendraw/tools/verify-browser.mjs",
    "test:native-window": "node apps/pendraw/tools/verify-native-window.mjs"
  }
}
